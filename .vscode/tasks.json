{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build FUJITORA",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "${workspaceFolder}/external/glad/glad.c",
                "${workspaceFolder}/external/imgui/*.cpp",
                "-I", "${workspaceFolder}/include",
                "-I", "${workspaceFolder}/external",
                "-I", "${workspaceFolder}/external/GLFW/include",
                "-I", "${workspaceFolder}/external/glad/include",
                "-I", "${workspaceFolder}/external/imgui",
                "-o", "${workspaceFolder}/build/FUJITORA",
                "-L", "${workspaceFolder}/external/GLFW/lib",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler task"
        }
    ]
}
